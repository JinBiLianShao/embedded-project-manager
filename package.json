{
  "name": "embedded-project-manager",
  "version": "2.1.0",
  "description": "嵌入式开发项目管理系统",
  "license": "MIT",
  "author": {
    "name": "liansixin",
    "email": "2013182991@qq.com"
  },
  "homepage": "https://github.com/liansixin/embedded-project-manager",
  "type": "commonjs",
  "main": "src/main/index.js",
  "scripts": {
    "build:renderer": "node build/build-renderer.mjs",
    "build": "npm run build:renderer && electron-builder",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "build:dir": "npm run build:renderer && electron-builder --dir",
    "start": "npm run build:renderer && electron .",
    "start:watch": "node build/build-renderer.mjs --watch"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "esbuild": "^0.28.2"
  },
  "build": {
    "productName": "embedded-project-manager",
    "appId": "com.embedded-project-manager",
    "copyright": "Copyright © 2026 南京仙容信息科技有限公司",
    "directories": {
      "output": "app_file",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "src/renderer/index.html",
      "src/renderer/bundle.js",
      "src/renderer/styles.css",
      "package.json"
    ],
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "./main.ico",
      "uninstallerIcon": "./main.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "embedded-project-manager"
    },
    "win": {
      "icon": "./main.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32",
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "icons",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "liansixin <2013182991@qq.com>",
      "synopsis": "嵌入式开发项目管理系统",
      "desktop": {
        "entry": {
          "Name": "Embedded Project Manager",
          "Comment": "管理嵌入式项目的版本与测试记录"
        }
      }
    }
  }
}
